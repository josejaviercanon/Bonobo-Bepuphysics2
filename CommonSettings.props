<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Version>1.0.0</Version>
        <Company>Bonobo Engine</Company>
        <Authors>Bonobo Engine;Ross Nordby</Authors>
        <Copyright>© Bepu Entertainment LLC; Bonobo Engine</Copyright>
        <PackageProjectUrl>https://github.com/josejaviercanon/Bonobo-Bepuphysics2</PackageProjectUrl>
        <RepositoryUrl>https://github.com/josejaviercanon/Bonobo-Bepuphysics2</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageIcon>bepuphysicslogo256.png</PackageIcon>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <DebugSymbols>true</DebugSymbols>
        <DelaySign>false</DelaySign>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)docs\bepuphysics2\images\bepuphysicslogo256.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>
</Project>
